{
  "expo": {
    "name": "PACE",
    "slug": "frontend",
    "version": "1.0.0",
    "scheme": "pace",
    "orientation": "portrait",
    "icon": "./assets/appLogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFCF5"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pace.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/appLogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/appLogo.png",
          "color": "#05966A",
          "sounds": [],
          "android": {
            "enableLargeIcons": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa6be507-842c-49f8-9524-27f3b30fb736"
      }
    }
  }
}
